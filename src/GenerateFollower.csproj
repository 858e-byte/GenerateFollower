<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- application Windows : pas de console au double-clic (AppWindow) ; les commandes en ligne écrivent dans la console
         parente (ParentConsole) -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- fenêtre de l'application : WinForms + WebView2 (AppWindow.cs) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- version affichée dans le Builder et le rapport de diagnostic -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- sans protection CET (shadow stack) dans l'exe : lancé depuis Mod Organizer 2, l'injection d'USVFS faisait planter
         l'exe au démarrage (0xc0000005, avant notre code, 22/10) ; dotnet.exe + la DLL marchait -->
    <CetCompat>false</CetCompat>
    <!-- icône de l'exe (bouclier « GF », même dessin que le HIMBO Converter ; refaite par beta\make_icon_gf.py) ;
         la fenêtre reprend celle de l'exe (AppWindow.AppIcon) -->
    <ApplicationIcon>GenerateFollower.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda" Version="0.54.4" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- application autonome (plan work\diag\autonome_dotnet\PLAN.md) : lecture des .nif (NiflySharp d'ousnius, GPL-3,
         100 % C#) et des .dds (MIT), à la place de PyNifly, texconv et Pillow -->
    <PackageReference Include="Nifly" Version="1.1.0" />
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <!-- archives .zip/.7z/.rar des skins (MIT), à la place de 7-Zip ; 0.48+ : faille GHSA-6c8g-7p36-r338 corrigée
         (WriteToDirectory, non utilisée ici) -->
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <!-- extraits de voix (xWMA) joués par Windows (XAudio2), sans ffmpeg (MIT) -->
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- fichiers de l'application intégrés à l'exe (AppResources.cs : un exe seul les dépose dans work\app\<version>\) :
         pages du Builder, scripts compilés, config.json par défaut -->
    <EmbeddedResource Include="..\builder\**\*" LogicalName="app/builder/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\papyrus\pex\*.pex" LogicalName="app/papyrus/pex/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\config.json" LogicalName="app/config.json" />
    <!-- seule DLL native (SDK WebView2) : déposée par AppResources.PrepareWebView2 dans work\app\, pas dans %TEMP% ; même
         version que le paquet Microsoft.Web.WebView2 ci-dessus -->
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2903.40\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="app/native/WebView2Loader.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- pas de using implicites WinForms : noms en conflit avec Mutagen et System (seul AppWindow.cs s'en sert) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
